[Unit]
Description=Woow EMQX MQTT broker (podman quadlet)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=woow-emqx
Image=docker.io/emqx/emqx:5.8.9
Network=emqx.network
HostName=emqx

# Optional: put overrides in ~/.config/containers/systemd/emqx.env
# (prefix `-` = OK if the file is missing)
EnvironmentFile=-%h/.config/containers/systemd/emqx.env

Environment=EMQX_DASHBOARD__DEFAULT_USERNAME=admin
Environment=EMQX_DASHBOARD__DEFAULT_PASSWORD=public
Environment=EMQX_NODE__NAME=emqx@127.0.0.1
Environment=EMQX_ALLOW_ANONYMOUS=true

PublishPort=1883:1883
PublishPort=8883:8883
PublishPort=8083:8083
PublishPort=8084:8084
PublishPort=18083:18083

Volume=woow-emqx-data:/opt/emqx/data
Volume=woow-emqx-log:/opt/emqx/log

HealthCmd=emqx ctl status
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=default.target
