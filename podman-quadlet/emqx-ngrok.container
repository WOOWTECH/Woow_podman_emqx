[Unit]
Description=Woow EMQX ngrok TCP tunnel (raw MQTT 1883)
After=emqx.service
Requires=emqx.service

[Container]
ContainerName=woow-emqx-ngrok
Image=docker.io/ngrok/ngrok:3
Network=emqx.network
HostName=emqx-ngrok

# Required: create ~/.config/containers/systemd/emqx-ngrok.env with:
#   NGROK_AUTHTOKEN=xxxxxxxxxxxx
#   (optional) NGROK_TCP_ADDR=1.tcp.ngrok.io:12345
EnvironmentFile=%h/.config/containers/systemd/emqx-ngrok.env

# ngrok reads NGROK_AUTHTOKEN from env automatically. If you use a reserved
# TCP address, edit the Exec line below to add --remote-addr=$NGROK_TCP_ADDR
# (Quadlet does not expand env vars inside Exec, so it must be hard-coded).
Exec=tcp emqx:1883 --log stdout

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
