# Optional ngrok TCP tunnel for raw MQTT (1883). Installed only while WOOW_EMQX_NGROK=1
# (scripts/install.sh --with-ngrok). It publishes the broker to the internet, which is acceptable only
# because anonymous access is off; install.sh stops this unit if the anonymous-MQTT smoke check fails.
# Public URL: scripts/ngrok-url.sh reads the latest WOOW_MQTT_PUBLIC_URL line.
[Unit]
Description=Woow EMQX ngrok TCP tunnel (optional)
Documentation=https://github.com/WOOWTECH/Woow_podman_emqx
Requires=emqx.service
After=emqx.service
PartOf=emqx.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Container]
ContainerName=woow-emqx-ngrok
Image=docker.io/ngrok/ngrok:3.39.11-alpine@sha256:187e588f6c4efe3b29cd3eea9fcd768a1afa7342319e3cee9aeb5af6a9cf64fd
Network=container:woow-emqx
Label=io.woowtech.stack=emqx
Secret=woow-emqx-ngrok-authtoken,type=env,target=NGROK_AUTHTOKEN
Environment=NGROK_REMOTE_ADDR=@@EMQX_NGROK_REMOTE_ADDR@@
Environment=WOOW_NGROK_UPSTREAM=127.0.0.1:1884
Environment=WOOW_NGROK_PROXY_PROTOCOL=true
PodmanArgs=--entrypoint=/bin/sh
Exec=/opt/woow/ngrok.sh
Volume=%h/.config/emqx/ngrok.sh:/opt/woow/ngrok.sh:ro,Z
Volume=%h/.config/emqx/ngrok-redact.awk:/opt/woow/ngrok-redact.awk:ro,Z
NoNewPrivileges=true

[Service]
# A container stopped by systemd is stopped with SIGTERM: an entrypoint that does not
# trap it exits 143 (128+15), which would leave the unit failed after a clean stop.
SuccessExitStatus=143
Restart=on-failure
RestartSec=15
TimeoutStartSec=300

[Install]
WantedBy=default.target
