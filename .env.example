# ============================================
# EMQX Docker / Podman Compose 環境變數
# Environment variables for EMQX Compose
# ============================================

# ===== EMQX 版本 / EMQX Version =====
# 對齊 Woow_ha_emqx (HA add-on v5.9.0 內含 EMQX v5.8.9)
# Aligned with Woow_ha_emqx (HA add-on v5.9.0 bundles EMQX v5.8.9)
EMQX_VERSION=5.8.9

# ===== Dashboard 設定 / Dashboard Settings =====
# Dashboard 管理員帳號 / Dashboard admin username
EMQX_DASHBOARD_USER=admin

# Dashboard 管理員密碼 / Dashboard admin password
# 生產環境請務必修改！/ Change this in production!
EMQX_DASHBOARD_PASSWORD=public

# Dashboard 網頁介面端口 / Dashboard Web UI port
EMQX_DASHBOARD_PORT=18083

# ===== MQTT 端口設定 / MQTT Port Settings =====
# 預設綁到 0.0.0.0（LAN 可連），生產環境請改成 127.0.0.1:PORT 或加防火牆
# Defaults bind to 0.0.0.0 (LAN reachable). For production, prefix with 127.0.0.1: or lock via firewall.
MQTT_TCP_PORT=1883
MQTT_SSL_PORT=8883
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084

# ===== 節點設定 / Node Settings =====
# EMQX 節點主機名稱或 IP（cluster mode 才會用到）
# EMQX node hostname or IP (only relevant in cluster mode)
EMQX_HOST=127.0.0.1

# ===== 安全設定 / Security Settings =====
# 是否允許匿名連接 / Allow anonymous connections
# 生產環境建議設為 false / Recommended false in production
EMQX_ALLOW_ANONYMOUS=true

# ===== ngrok TCP tunnel（選用）/ ngrok TCP tunnel (optional) =====
# 對齊 Woow_ha_emqx 的 ngrok 內建行為：把 raw MQTT (1883) 透過 ngrok 暴露成公開 TCP 通道。
# Aligned with Woow_ha_emqx built-in ngrok: expose raw MQTT (1883) as a public TCP tunnel.
#
# 啟用方式（不會被 default up 起來，只有 --profile ngrok 才會）：
#   docker  compose --profile ngrok up -d
#   podman-compose --profile ngrok up -d
#
# 8083 (MQTT-over-WebSocket) 不在 ngrok 範圍，請用 Cloudflare Tunnel。
# 8083 (MQTT-over-WebSocket) is out of scope; use Cloudflare Tunnel instead.

# ngrok authtoken（啟用 ngrok profile 時必填）
# ngrok authtoken (required when enabling the ngrok profile)
NGROK_AUTHTOKEN=

# ngrok 保留 TCP 位址（選填）
# 空 → ngrok 自動指派臨時位址（重啟後可能變）
# 填 → 例如 `1.tcp.ngrok.io:12345`，用你在 ngrok 帳號中保留的固定位址
# ngrok reserved TCP address (optional)
# empty → ngrok auto-assigns (may change on restart)
# set   → e.g. `1.tcp.ngrok.io:12345`, uses your reserved address
NGROK_TCP_ADDR=
