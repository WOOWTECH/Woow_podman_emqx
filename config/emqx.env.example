# ~/.config/emqx/emqx.env: created by scripts/install.sh (mode 0600) and passed to the broker through
# EnvironmentFile= (no '-' prefix: the file must exist).
#
# Rules: KEY=VALUE per line, no quotes, no inline "# comments" after a value (podman --env-file keeps
# them as part of the value). No secrets here: install.sh refuses PASSWORD/SECRET/TOKEN keys and keeps
# the credentials in podman secrets instead:
#   woow-emqx-dashboard-password   dashboard user "admin"
#   woow-emqx-mqtt-password        MQTT user WOOW_EMQX_MQTT_USER (seeded through woow-emqx-mqtt-bootstrap)
#   woow-emqx-ngrok-authtoken      only with --with-ngrok
# Read one back in a private terminal with:
#   podman secret inspect --showsecret --format '{{.SecretData}}' <name>
# After editing this file, run scripts/install.sh again: it re-renders and restarts what changed.

# --- EMQX overrides (any EMQX_* key; a double underscore means nesting) ---
EMQX_LOG__CONSOLE__LEVEL=warning

# --- installer knobs (read by scripts/install.sh; EMQX ignores non-EMQX_ variables) ---
# 127.0.0.1 (default), an IPv4 address of this host, or "all" (every address, IPv4 and IPv6).
# A LAN broker is safe only because authentication is enforced.
WOOW_EMQX_BIND=127.0.0.1
WOOW_EMQX_PORT_MQTT=1883
WOOW_EMQX_PORT_MQTTS=8883
WOOW_EMQX_PORT_WS=8083
WOOW_EMQX_PORT_WSS=8084
WOOW_EMQX_PORT_DASHBOARD=18083
# MQTT user seeded on first start (its password is the woow-emqx-mqtt-password secret).
WOOW_EMQX_MQTT_USER=woow
# 1 = also run the ngrok TCP tunnel for port 1883 (set by install.sh --with-ngrok / --without-ngrok).
WOOW_EMQX_NGROK=0
# Optional reserved ngrok TCP address, for example 1.tcp.ngrok.io:12345. Empty = random address.
WOOW_EMQX_NGROK_REMOTE_ADDR=
